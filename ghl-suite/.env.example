# Public https URL of the suite (no trailing slash). Every app lives under it:
#   ${BASE_URL}/lead-scorer  /round-robin  /contact-cleaner  /after-hours  /birthday-greeter
BASE_URL=https://apps.yourdomain.com
PORT=3000

# 32+ random characters. Signs sessions and encrypts stored HighLevel tokens.
SESSION_SECRET=
# Super Admin: ${BASE_URL}/admin
ADMIN_PASSWORD=change-me-to-something-long
# Protects /api/cron/daily (Vercel Cron sends it automatically when set).
CRON_SECRET=

# MongoDB Atlas (free M0 cluster is enough). Required on Vercel.
# Leave empty locally to use an in-memory store.
MONGODB_URI=
MONGODB_DB=GhlAppSuite

# One HighLevel Marketplace app per product. Client ID + Secret from
# Advanced Settings > Auth; SSO key = the app's "Shared Secret".
LEAD_SCORER_CLIENT_ID=
LEAD_SCORER_CLIENT_SECRET=
LEAD_SCORER_SSO_KEY=

ROUND_ROBIN_CLIENT_ID=
ROUND_ROBIN_CLIENT_SECRET=
ROUND_ROBIN_SSO_KEY=

CONTACT_CLEANER_CLIENT_ID=
CONTACT_CLEANER_CLIENT_SECRET=
CONTACT_CLEANER_SSO_KEY=

AFTER_HOURS_CLIENT_ID=
AFTER_HOURS_CLIENT_SECRET=
AFTER_HOURS_SSO_KEY=

BIRTHDAY_GREETER_CLIENT_ID=
BIRTHDAY_GREETER_CLIENT_SECRET=
BIRTHDAY_GREETER_SSO_KEY=

# Optional: HighLevel's webhook public keys (PEM) from the webhook docs.
# With them, unsigned or forged webhooks are rejected.
GHL_WEBHOOK_ED25519_KEY=
GHL_WEBHOOK_RSA_KEY=

# Branding shown on the landing pages and legal pages
BRAND_NAME=Growth Apps
SUPPORT_EMAIL=support@yourdomain.com
LEGAL_NAME=Growth Apps
PRICE_LABEL=$97 / month
