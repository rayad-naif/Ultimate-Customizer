# Public https URL where this server is reachable (no trailing slash).
# Your GHL app's Redirect URL must be: ${BASE_URL}/oauth/callback
BASE_URL=https://cuztomizer.ironix.dev
PORT=3000

# HighLevel Marketplace app (Target User: Agency)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Space separated. companies.readonly lets us read the agency name.
GHL_SCOPES=companies.readonly

# Optional: webhook signature keys from the HighLevel webhook guide (PEM).
# Without them, UNINSTALL webhooks are double-checked by refreshing the token.
GHL_WEBHOOK_ED25519_KEY=
GHL_WEBHOOK_RSA_KEY=

# New installs: active (licensed immediately) or pending (you approve each in Super Admin)
NEW_INSTALL_STATUS=active

# Super Admin panel login: ${BASE_URL}/admin/login
ADMIN_PASSWORD=change-me-to-something-long

# 32+ random characters. Signs sessions and encrypts stored GHL tokens.
SESSION_SECRET=

# MongoDB Atlas connection string (required on Vercel). Stores every agency,
# its theme settings, keys and the activity log.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=UltimateThemeCustomizer

# Protects the daily install check (Vercel Cron sends it automatically).
CRON_SECRET=

# Local development only: without MONGODB_URI, data goes to a JSON file here.
DATA_DIR=./data

# Branding / legal pages (optional)
BRAND_NAME=Ultimate Customizer
SUPPORT_EMAIL=idylle_radieuse@outlook.com
LEGAL_NAME=Ultimate Customizer
LEGAL_UPDATED=October 13, 2026
# Your HighLevel Marketplace listing URL (used by the "Install" buttons)
MARKETPLACE_URL=
